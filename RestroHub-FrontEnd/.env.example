# =========================================================================
# RestroHub Frontend Environment Variables
# Copy this file to .env and adjust values for your environment.
# Note: Vite only exposes variables prefixed with VITE_ to the browser.
# =========================================================================

# --- API Configuration ---
# The base URL pointing to the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8181/restroly

# --- Google OAuth 2.0 Configuration ---
# Create client credentials in the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Note: This client ID must match the GOOGLE_OAUTH_CLIENT_ID in the backend.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here


# --- SEO ---
# Public site origin (no trailing slash); used for canonical/og URLs, sitemap.xml and robots.txt at build time
VITE_SITE_URL=http://localhost:3000

# --- Analytics ---
# GA4 ID like G-XXXXXXXXXX; leave empty to disable analytics and the consent banner
VITE_GA_MEASUREMENT_ID=

# --- Spam protection ---
# honeypot (default, no keys) or turnstile (Cloudflare Turnstile; needs the site key below). Must match backend SPAM_PROTECTION_MODE.
VITE_SPAM_PROTECTION_MODE=honeypot
# Cloudflare Turnstile site key (public); only used when mode is turnstile
VITE_TURNSTILE_SITE_KEY=
