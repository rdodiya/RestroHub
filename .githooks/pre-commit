#!/usr/bin/env bash
# Pre-commit quality gate for RestroHub (backend + frontend).
# Enable once per clone:  git config core.hooksPath .githooks
# (Frontend `npm install` does this automatically via the `prepare` script.)
# Bypass in an emergency:  git commit --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$STAGED" ] && exit 0

fail() { echo "❌ $1"; exit 1; }

# 1) Never commit env files / secrets
if echo "$STAGED" | grep -E '(^|/)\.env(\.[^/]+)?$' | grep -v '\.env\.example$' | grep -q .; then
  fail "A .env file is staged. Remove it: git reset HEAD <file> (only .env.example may be committed)."
fi

# 2) Java: Spotless format check
if echo "$STAGED" | grep -qE '^RestroHub/.*\.java$'; then
  echo "▶ Java: spotlessCheck"
  # Ensure JAVA_HOME is Java 21 or 17 (and not Java 11)
  NEED_JAVA=true
  if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" -o -x "$JAVA_HOME/bin/java.exe" ]; then
    JH_VER=$("$JAVA_HOME/bin/java" -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d'.' -f1)
    if [ "$JH_VER" = "21" ] || [ "$JH_VER" = "17" ]; then
      NEED_JAVA=false
    fi
  fi

  if [ "$NEED_JAVA" = true ]; then
    for cand in "D:/Software/jdk-21.0.4" "/d/Software/jdk-21.0.4" "C:/Program Files/Java/jdk-21" "/c/Program Files/Java/jdk-21" "D:/Software/jdk-17.0.12" "/d/Software/jdk-17.0.12" "C:/Program Files/Java/jdk-17" "/c/Program Files/Java/jdk-17"; do
      if [ -d "$cand" ] && [ -f "$cand/bin/java" -o -f "$cand/bin/java.exe" ]; then
        export JAVA_HOME="$cand"
        export PATH="$cand/bin:$PATH"
        break
      fi
    done
  fi
  ( cd "$ROOT/RestroHub" && ./gradlew spotlessCheck --quiet ) \
    || fail "Java formatting failed. Fix with: cd RestroHub && ./gradlew spotlessApply  (then git add)"
fi

# 3) Frontend: ESLint + Prettier on staged files only (auto-fixes and re-stages)
if echo "$STAGED" | grep -qE '^RestroHub-FrontEnd/.*\.(js|jsx|mjs|cjs|css|json|md|html)$'; then
  echo "▶ Frontend: lint-staged (ESLint + Prettier)"
  [ -d "$ROOT/RestroHub-FrontEnd/node_modules" ] \
    || fail "Run 'npm install' in RestroHub-FrontEnd first."
  ( cd "$ROOT/RestroHub-FrontEnd" && npx --no-install lint-staged ) \
    || fail "ESLint/Prettier found problems. Fix them and commit again."
fi

echo "✅ Pre-commit checks passed"
